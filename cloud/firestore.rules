rules_version = '2';
// Server-managed access/{uid}: {approved:boolean}; clients cannot grant access.
// Owner profiles: {ownerUid,profileId,revision:int,body:string<=24000 chars}.
// Immutable child events: {ownerUid,profileId,eventId,body:string<=24000 chars}.
// Immutable deletion markers: {ownerUid,profileId}; they authorize cleanup only.
// Serialized bodies receive full schema validation in the local storage layer.
service cloud.firestore {
  match /databases/{database}/documents {
    function approvedOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/access/$(uid))
        && get(/databases/$(database)/documents/access/$(uid)).data.approved == true;
    }
    function validId(id) { return id is string && id.matches('^[A-Za-z0-9_-][A-Za-z0-9._:-]{0,127}$'); }
    function active(uid, profileId) { return !exists(/databases/$(database)/documents/users/$(uid)/deletions/$(profileId)); }
    function validProfile(uid, profileId) {
      let data = request.resource.data;
      return validId(profileId)
        && data.keys().hasAll(['ownerUid', 'profileId', 'revision', 'body'])
        && data.keys().hasOnly(['ownerUid', 'profileId', 'revision', 'body'])
        && data.ownerUid == uid && data.profileId == profileId
        && data.revision is int && data.revision >= 0
        && data.body is string && data.body.size() <= 24000;
    }
    function validEvent(uid, profileId, eventId) {
      let data = request.resource.data;
      return validId(eventId)
        && data.keys().hasAll(['ownerUid', 'profileId', 'eventId', 'body'])
        && data.keys().hasOnly(['ownerUid', 'profileId', 'eventId', 'body'])
        && data.ownerUid == uid && data.profileId == profileId && data.eventId == eventId
        && data.body is string && data.body.size() <= 24000;
    }
    match /access/{uid} {
      // Admission is provisioned through the owner console/Admin tooling only.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /users/{uid}/profiles/{profileId} {
      allow get, list: if approvedOwner(uid);
      allow create: if approvedOwner(uid) && active(uid, profileId) && validProfile(uid, profileId);
      allow update: if approvedOwner(uid) && active(uid, profileId) && validProfile(uid, profileId)
        && request.resource.data.revision >= resource.data.revision;
      allow delete: if approvedOwner(uid) && !active(uid, profileId);
      match /events/{eventId} {
        allow get, list: if approvedOwner(uid);
        allow create: if approvedOwner(uid) && active(uid, profileId)
          && exists(/databases/$(database)/documents/users/$(uid)/profiles/$(profileId))
          && validEvent(uid, profileId, eventId);
        allow update: if false;
        allow delete: if approvedOwner(uid)
          && exists(/databases/$(database)/documents/users/$(uid)/deletions/$(profileId));
      }
    }
    match /users/{uid}/deletions/{profileId} {
      allow get, list: if approvedOwner(uid);
      allow create: if approvedOwner(uid) && validId(profileId)
        && request.resource.data.keys().hasAll(['ownerUid', 'profileId'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'profileId'])
        && request.resource.data.ownerUid == uid && request.resource.data.profileId == profileId;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
